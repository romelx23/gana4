---
// Pega aquí la URL de tu App Web de Google Apps Script (ver flutter/waitlist/README.md).
const WAITLIST_ENDPOINT = "PEGA_TU_URL_DEL_APPS_SCRIPT_AQUI";
---

<section id="acceso" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="glass relative overflow-hidden rounded-[2rem] px-6 py-14 sm:px-12">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-accent/25 via-transparent to-cyan/20"
    >
    </div>

    <div class="relative mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent-soft">
        Acceso anticipado
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">
        Sé el primero en probar las <span class="text-gradient">próximas novedades</span>
      </h2>
      <p class="mt-4 text-txt-soft">
        Gana4 ya está en Google Play. Déjanos tu correo y te avisamos antes que nadie cuando
        salgan nuevos modos, personajes y funciones.
      </p>

      <form
        id="waitlist-form"
        class="mx-auto mt-8 max-w-md space-y-3 text-left"
        data-app="gana4"
        data-endpoint={WAITLIST_ENDPOINT}
        novalidate
      >
        <div>
          <label for="wl-name" class="sr-only">Tu nombre</label>
          <input
            id="wl-name"
            name="nombre"
            type="text"
            required
            maxlength="80"
            autocomplete="name"
            placeholder="Tu nombre"
            class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3.5 text-txt placeholder:text-txt-muted outline-none transition focus:border-accent/60 focus:bg-white/10"
          />
        </div>
        <div>
          <label for="wl-email" class="sr-only">Tu correo</label>
          <input
            id="wl-email"
            name="email"
            type="email"
            required
            maxlength="120"
            autocomplete="email"
            placeholder="tu@correo.com"
            class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3.5 text-txt placeholder:text-txt-muted outline-none transition focus:border-accent/60 focus:bg-white/10"
          />
        </div>
        <button
          type="submit"
          class="w-full rounded-2xl bg-accent px-6 py-4 font-display font-semibold text-white shadow-lg shadow-accent/30 transition hover:-translate-y-0.5 hover:bg-accent-soft hover:text-ink disabled:cursor-wait disabled:opacity-70 disabled:hover:translate-y-0"
        >
          Unirme al acceso anticipado
        </button>
        <p
          id="waitlist-msg"
          role="status"
          aria-live="polite"
          class="min-h-[1.4em] text-center text-sm font-semibold"
        >
        </p>
        <p class="text-center text-xs text-txt-muted">
          Sin spam: solo te escribimos cuando haya novedades.
          <a href="/privacidad" class="underline underline-offset-2 hover:text-txt">Política de privacidad</a>
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const form = document.getElementById("waitlist-form") as HTMLFormElement | null;

  if (form) {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const msg = document.getElementById("waitlist-msg");
    const endpoint = form.dataset.endpoint ?? "";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!btn || !msg) return;

      const nombre = (form.nombre as HTMLInputElement).value.trim();
      const email = (form.email as HTMLInputElement).value.trim();
      const app = form.dataset.app ?? "gana4";

      msg.textContent = "";
      msg.classList.remove("text-success", "text-danger");

      if (nombre.length < 2) {
        msg.textContent = "Escribe tu nombre para continuar.";
        msg.classList.add("text-danger");
        return;
      }
      if (!EMAIL_RE.test(email)) {
        msg.textContent = "Escribe un correo válido.";
        msg.classList.add("text-danger");
        return;
      }
      if (!endpoint.includes("script.google.com")) {
        msg.textContent = "Formulario en configuración: aún no se conectó el servidor.";
        msg.classList.add("text-danger");
        return;
      }

      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = "Enviando…";

      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({ app, nombre, email }),
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.error ?? "error");

        msg.textContent = "¡Listo! Te avisaremos de las próximas novedades de Gana4.";
        msg.classList.add("text-success");
        form.reset();
      } catch {
        msg.textContent = "No se pudo enviar. Intenta de nuevo en unos segundos.";
        msg.classList.add("text-danger");
      } finally {
        btn.disabled = false;
        btn.textContent = original ?? "Unirme al acceso anticipado";
      }
    });
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

---
const features = [
  {
    title: "Contra la máquina",
    body: "Una IA con tres niveles: fácil, medio y difícil. Ideal para entrenar o pasar un rato.",
    icon: "cpu",
  },
  {
    title: "Copa oficial",
    body: "Tres rondas de eliminatoria: cuartos, semifinal y final. Gana el trofeo y guarda tu récord.",
    icon: "trophy",
  },
  {
    title: "Multijugador por WiFi",
    body: "Juega con quien esté en la misma red. La partida viaja solo por tu red local: sin internet.",
    icon: "wifi",
  },
  {
    title: "Avatar con voz",
    body: "Tu compañero comenta la partida con frases en español, con audio y burbuja de diálogo.",
    icon: "mic",
  },
  {
    title: "100 % offline",
    body: "Sin cuentas, sin correo, sin base de datos. Todo se guarda en tu propio dispositivo.",
    icon: "shield",
  },
  {
    title: "Gratis, sin compras",
    body: "Juego completo y gratuito. Sin compras dentro de la app: solo anuncios opcionales.",
    icon: "gift",
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-widest text-accent-soft">Características</p>
    <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">
      Todo lo que necesitas para jugar
    </h2>
    <p class="mt-4 text-txt-soft">
      Gana4 funciona completamente en tu teléfono: nada de servidores, ni registro, ni datos que
      compartir.
    </p>
  </div>

  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <li class="glass rounded-2xl p-6 transition hover:border-accent/40">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent/15 text-accent-soft">
            {feature.icon === "cpu" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="7" y="7" width="10" height="10" rx="2" />
                <path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4" />
              </svg>
            )}
            {feature.icon === "trophy" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 4h8v5a4 4 0 0 1-8 0V4Z" />
                <path d="M8 5H5a3 3 0 0 0 3 3M16 5h3a3 3 0 0 1-3 3" />
                <path d="M12 13v3M9 20h6M10 16h4l1 4H9l1-4Z" />
              </svg>
            )}
            {feature.icon === "wifi" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2.5 8.5a15 15 0 0 1 19 0M5.5 12a10.5 10.5 0 0 1 13 0M8.5 15.5a6 6 0 0 1 7 0" />
                <circle cx="12" cy="19" r="1.2" fill="currentColor" />
              </svg>
            )}
            {feature.icon === "mic" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="3" width="6" height="11" rx="3" />
                <path d="M5 11a7 7 0 0 0 14 0M12 18v3" />
              </svg>
            )}
            {feature.icon === "shield" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3 5 6v5.5c0 4.3 2.9 8.2 7 9.5 4.1-1.3 7-5.2 7-9.5V6l-7-3Z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            )}
            {feature.icon === "gift" && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="8" width="18" height="5" rx="1" />
                <path d="M5 13v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7M12 8v13" />
                <path d="M12 8S10.5 4 8.5 4a2 2 0 0 0 0 4H12Zm0 0s1.5-4 3.5-4a2 2 0 0 1 0 4H12Z" />
              </svg>
            )}
          </div>

          <h3 class="mt-5 font-display text-lg font-semibold text-txt">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-txt-soft">{feature.body}</p>
        </li>
      ))
    }
  </ul>
</section>
